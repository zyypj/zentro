<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>[%d{HH:mm:ss}] [%-5level] %logger{0}: %msg%n</pattern>
        </encoder>
    </appender>
    <root level="WARN">
        <appender-ref ref="STDOUT"/>
    </root>
    <logger name="dev.zentro" level="INFO"/>
    <logger name="io.ktor.server.Application" level="INFO"/>
    <logger name="Exposed" level="WARN"/>
</configuration>
